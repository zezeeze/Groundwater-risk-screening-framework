{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroundwaterSpectra-LLM well-level output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "well_id",
    "model_status",
    "risk_screening_level",
    "overall_assessment",
    "supporting_evidence",
    "counter_evidence",
    "priority_risk_categories",
    "confirmatory_tests",
    "contaminant_enterprise_links",
    "suspected_enterprises",
    "quality_control_checks",
    "unexcluded_risks",
    "uncertainty",
    "evidence_trace"
  ],
  "properties": {
    "well_id": {
      "type": "string"
    },
    "model_status": {
      "enum": [
        "Both-high",
        "EEM-only high",
        "UV-Vis-only high",
        "Both-low"
      ]
    },
    "risk_screening_level": {
      "enum": [
        "Low Risk",
        "Risk Alert",
        "High Risk"
      ]
    },
    "overall_assessment": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "priority_risk_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "rank",
          "eem_probability",
          "uvvis_probability",
          "evidence_summary",
          "uncertainty"
        ],
        "properties": {
          "category": {
            "enum": [
              "常规水质与营养盐",
              "盐分与矿化度",
              "常见金属",
              "毒性金属与类金属",
              "特征有机污染物"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "eem_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "uvvis_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_summary": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    },
    "confirmatory_tests": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "description": "Ten ranked confirmatory-test candidates forming a compact five-item list and an extended ten-item screening panel.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "indicator",
          "priority",
          "purpose",
          "supporting_evidence_ids",
          "method_or_qc_note"
        ],
        "properties": {
          "indicator": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9]{3}$"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Each value must match an evidence_id defined in supporting_evidence."
          },
          "method_or_qc_note": {
            "type": "string"
          }
        }
      }
    },
    "suspected_enterprises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enterprise_id",
          "rank",
          "relation_evidence",
          "supporting_source_ids",
          "uncertainty"
        ],
        "properties": {
          "enterprise_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "relation_evidence": {
            "type": "string"
          },
          "supporting_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": "string"
          }
        }
      },
      "minItems": 5,
      "maxItems": 5
    },
    "quality_control_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unexcluded_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "evidence_ids",
          "feature_ids",
          "rag_chunk_ids",
          "source_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Evidence identifiers supporting this claim. Each value must match an evidence_id defined in supporting_evidence or counter_evidence.",
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9]{3}$"
            }
          },
          "feature_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rag_chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contaminant_enterprise_links": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "description": "Ten ranked, traceable candidate contaminant-enterprise links.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "enterprise_id",
          "candidate_contaminant",
          "risk_category",
          "linkage_evidence",
          "supporting_source_ids",
          "uncertainty"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "enterprise_id": {
            "type": "string"
          },
          "candidate_contaminant": {
            "type": "string"
          },
          "risk_category": {
            "enum": [
              "常规水质与营养盐",
              "盐分与矿化度",
              "常见金属",
              "毒性金属与类金属",
              "特征有机污染物"
            ]
          },
          "linkage_evidence": {
            "type": "string"
          },
          "supporting_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "modality",
        "feature_id",
        "feature_family",
        "value_or_probability",
        "shap_value",
        "source_ids",
        "statement"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[0-9]{3}$",
          "description": "Response-level unique evidence identifier. IDs are assigned sequentially across supporting_evidence and counter_evidence and must not be reused."
        },
        "evidence_type": {
          "enum": [
            "observation",
            "model",
            "knowledge"
          ]
        },
        "modality": {
          "enum": [
            "eem",
            "uv_vis",
            "cross-modal"
          ]
        },
        "feature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_or_probability": {
          "type": [
            "number",
            "string"
          ]
        },
        "shap_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statement": {
          "type": "string"
        }
      }
    }
  },
  "description": "Fixed well-level output schema. Evidence IDs use the EV-001 format. Every supporting_evidence_id in confirmatory_tests must resolve to an evidence_id in supporting_evidence. Every evidence_id listed in evidence_trace must resolve to an evidence record in supporting_evidence or counter_evidence. Cross-field referential integrity is checked after JSON Schema validation."
}
